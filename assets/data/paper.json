  "summary": {
    "src": "Table 3 (the paper at a glance; the reader study revised the shaded rows RQ3 and RQ5)",
    "rows": [
      {
        "rq": "RQ1",
        "name": "Controllability",
        "found": "Every model tells a story more chronologically than its published telling; cued for a shape, band hit is 47.9%, and the two misses are the literal solutions of rules stated on events.",
        "careful": "The reference works were chosen for nonlinearity, both free tasks list events chronologically, and no prompt marks scenes. Band hit is negatively associated with reader preference, partly through condition.",
        "revised": false
      },
      {
        "rq": "RQ2",
        "name": "Task validity",
        "found": "Reconstruction reaches τ_rec = 0.743; naming the shape reaches 50.2%, with analepsis a sink.",
        "careful": "96.1% of that τ is reachable with the story deleted (by entailment or prior knowledge of the work), and readers reach only 0.537: report the floor, prefer exact match.",
        "revised": false
      },
      {
        "rq": "RQ3",
        "name": "Representation",
        "found": "The graph raises compliance from 41.1% to 51.8%, almost all in one model, and readers prefer it to a supplied told order 72% of the time.",
        "careful": "The judge saw no effect, and the two prompts differ in more than the graph. The edge over an event list is a length effect, and readers prefer every one-layer ablation to the full graph.",
        "revised": true
      },
      {
        "rq": "RQ4",
        "name": "Cost of control",
        "found": "Cued tellings lose to a model’s own free telling under the judge (68–19) and readers (76%), even for chronicle. As scored, the reveal comes after fewer than three events in 21.4% of stories.",
        "careful": "Two scoring cases inflate the early rate (8.3% without them). Retrospective coherence gain is capped near 0.12 by the same floor.",
        "revised": false
      },
      {
        "rq": "RQ5",
        "name": "Evaluation validity",
        "found": "The judge matches 71 readers on the one large effect, and readers overturn both of its ties (κ = −0.030 on layer removal).",
        "careful": "Item-level agreement does not track effect size; fourteen stories, two generators in the layer-removal study, no comparison against human-written prose.",
        "revised": true
      }
    ]
  }
